# Copy to .env.local for local development. Never commit real credentials.
MONGODB_URI=mongodb+srv://DB_USER:URL_ENCODED_PASSWORD@CLUSTER/summit
MONGODB_DB=summit

# Gmail: enable 2-Step Verification and create an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-summit-account@gmail.com
SMTP_PASS=your-16-character-app-password
# Optional; defaults to SUMMIT <SMTP_USER>. Use an authorized sender.
# MAIL_FROM=SUMMIT <your-summit-account@gmail.com>
